{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-vs-railway-gateway",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "NEXT_PUBLIC_GATEWAY_WS=wss://gateway-production-1c11.up.railway.app/ws pnpm --filter @livecanvas/web dev"
      ],
      "port": 3000
    },
    {
      "name": "web-vs-local-gateway",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "NEXT_PUBLIC_GATEWAY_WS=ws://localhost:8787/ws pnpm --filter @livecanvas/web dev"
      ],
      "port": 3000
    },
    {
      "name": "web-prod-vs-railway-gateway",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "NEXT_PUBLIC_GATEWAY_WS=wss://gateway-production-1c11.up.railway.app/ws pnpm --filter @livecanvas/web build && pnpm --filter @livecanvas/web start"
      ],
      "port": 3000
    },
    {
      "name": "gateway-local-8788",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd apps/gateway && PORT=8788 ADMIN_TOKEN=lc-local-test-admin-token-0000000000 PROMPTS_DIR=../../prompts pnpm exec tsx src/server.ts"
      ],
      "port": 8788
    },
    {
      "name": "web-vs-8788",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "NEXT_PUBLIC_GATEWAY_WS=ws://localhost:8788/ws pnpm --filter @livecanvas/web dev"
      ],
      "port": 3000
    },
    {
      "name": "gateway-m8-8788",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "railway run --service gateway -- env -u DATABASE_URL -u REDIS_URL -u DATABASE_PUBLIC_URL -u ACCESS_SECRET CORS_ORIGINS=http://localhost:3001 ADMIN_ORIGINS=http://localhost:3001 ADMIN_TOKEN=lc-local-test-admin-token-0000000000 PORT=8788 HOST=127.0.0.1 apps/gateway/node_modules/.bin/tsx apps/gateway/src/server.ts"
      ],
      "port": 8788
    },
    {
      "name": "web-m8-3001",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "NEXT_PUBLIC_GATEWAY_WS=ws://localhost:8788/ws pnpm --filter @livecanvas/web exec next dev -p 3001"
      ],
      "port": 3001
    }
  ]
}